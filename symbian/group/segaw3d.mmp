// ---------------------------------------------------------------------------------------------------------------
//  segaw3d.mmp: el emulador de Mega Drive (PicoDrive) para el Nokia N95, con hasta 4 mandos de PS3/PS4 por el Team
//  Player. Las rutas suponen el arbol del ecosistema:
//      Whisk3decosystem\Whisk3D                         el motor (libs\Whisk3DCore y platform\symbian)
//      Whisk3decosystem\emuladores-pros\sega            este emulador (src\, picodrive\, symbian\)
//  El nucleo (picodrive\) entra por los envoltorios de ..\pd (herramientas\pd_symbian.py los genera).
// ---------------------------------------------------------------------------------------------------------------
TARGET          segaw3d.exe
TARGETTYPE      exe
// UID3 del rango de pruebas (sin proteger): el mismo de inc\segaw3d.h, los .rss y el .pkg
UID             0x100039CE 0xE5E6A001
VENDORID        0

// la pila del hilo principal: la del editor (el maximo de EKA2). El heap: la ROM (hasta 4 MB) y la memoria de la
// consola (y la del 32X / Mega CD si hiciera falta)
EPOCSTACKSIZE   0x14000
EPOCHEAPSIZE    0x100000 0x4000000

CAPABILITY      ReadUserData WriteUserData

// el Core en su dialecto de Symbian, el mezclador de sonido y sin el editor
MACRO           W3D_SYMBIAN
MACRO           W3D_ENABLE_AUDIO
MACRO           W3D_SIN_EDITOR
// el nucleo de PicoDrive con lo que hay en asm ARM (pdasm.lib, de herramientas\asm_symbian.py: GNU as, ensamblado con
// el gcc de CodeSourcery): el 68000 (Cyclone), el Z80 (DrZ80), el sonido FM, las copias de memoria, el dibujo de los
// planos y los sprites y la memoria del 68000
MACRO           EMU_C68K
MACRO           _USE_DRZ80
MACRO           _ASM_YM2612_C
MACRO           _ASM_MISC_C
MACRO           _ASM_DRAW_C
MACRO           _ASM_MEMORY_C
MACRO           NDEBUG

// RVCT 2.2: ARM, ARMv6 y la VFP por hardware (sin ARMFPU el exe sale softvfp y el sistema EMULA cada operacion de
// punto flotante). --gnu: el C de PicoDrive es C99 con extensiones de gcc (las declaraciones en el medio, inline)
ALWAYS_BUILD_AS_ARM
ARMFPU          vfpv2
OPTION_REPLACE  ARMCC --cpu 6
OPTION_REPLACE  ARMCC --fpu vfpv2 --fpmode fast
OPTION_REPLACE  ARMCC -O3 -Otime
OPTION          ARMCC --gnu --diag_suppress 1215,177,550,186,111,68,61,940,1293,1295,174,767,1294,167,513,188,191,1296,47

// --- la aplicacion de S60 (el framework, el bucle, las teclas), la plataforma y la pantalla (Direct Screen Access:
// por CPU, directo en la pantalla)
SOURCEPATH      ..\src
SOURCE          sega_app.cpp sega_contenedor.cpp plataforma_symbian.cpp pantalla_symbian.cpp

// --- el emulador (src\pc\ y src\pantalla.cpp, con OpenGL, son solo la prueba en la PC)
SOURCEPATH      ..\..\src
SOURCE          juego.cpp menu.cpp emu.c

// --- el nucleo de PicoDrive
#include "pd_fuentes.mmh"

// --- el Core de Whisk3D: el log, los archivos, los mandos y el sonido
SOURCEPATH      ..\..\..\..\Whisk3D\libs\Whisk3DCore\base
SOURCE          w3dlog.cpp
// los joysticks de PS3/PS4 por Bluetooth (bthidhost.dll se carga en runtime: sin el driver, no hay mandos y anda igual)
SOURCE          W3dMandosSymbian.cpp
SOURCEPATH      ..\..\..\..\Whisk3D\libs\Whisk3DCore\io
SOURCE          w3dFilesystem.cpp
// (el sonido: el mezclador y su salida de Symbian, CMdaAudioOutputStream en su hilo)
SOURCEPATH      ..\..\..\..\Whisk3D\libs\Whisk3DCore\audio
SOURCE          W3dAudio.cpp W3dAudioSymbian.cpp
// new/delete propios del editor de Symbian: sin ellos el exe importa scppnwdl.dll, que el N95 no tiene ("funcion no
// admitida" al abrir)
SOURCEPATH      ..\..\..\..\Whisk3D\platform\symbian\src
SOURCE          newdel_compat.cpp

// (las rutas de los recursos se resuelven contra el ultimo SOURCEPATH)
SOURCEPATH      ..\data
START RESOURCE  segaw3d.rss
HEADER
TARGETPATH      \resource\apps
LANG            SC
END
START RESOURCE  segaw3d_reg.rss
#ifdef WINSCW
TARGETPATH      \private\10003a3f\apps
#else
TARGETPATH      \private\10003a3f\import\apps
#endif
END

USERINCLUDE     ..\inc
USERINCLUDE     ..\..\src
USERINCLUDE     ..\..\picodrive
USERINCLUDE     ..\..\picodrive\zlib
USERINCLUDE     ..\..\..\..\Whisk3D\libs\Whisk3DCore
USERINCLUDE     ..\..\..\..\Whisk3D\libs\Whisk3DCore\base
USERINCLUDE     ..\..\..\..\Whisk3D\libs\Whisk3DCore\audio
USERINCLUDE     ..\..\..\..\Whisk3D\libs\Whisk3DCore\io
// fscompat.h (el log del Core cierra el RFs sin importar efsrv@390, que el N95 no tiene)
USERINCLUDE     ..\..\..\..\Whisk3D\platform\symbian\inc

// (PicoDrive se incluye a si mismo con <pico/...>, <cpu/...>, <zlib.h>: tambien como de sistema)
SYSTEMINCLUDE   ..\..\picodrive
SYSTEMINCLUDE   ..\..\picodrive\zlib
// Open C / Open C++ y las carpetas del SDK
SYSTEMINCLUDE   \epoc32\include
SYSTEMINCLUDE   \epoc32\include\stdapis
SYSTEMINCLUDE   \epoc32\include\stdapis\stlport
SYSTEMINCLUDE   \epoc32\include\stdapis\stlport\stl
SYSTEMINCLUDE   \epoc32\include\mw
SYSTEMINCLUDE   \epoc32\include\app
SYSTEMINCLUDE   \epoc32\include\platform
SYSTEMINCLUDE   \epoc32\include\platform\mw

LIBRARY         euser.lib apparc.lib cone.lib eikcore.lib avkon.lib ws32.lib efsrv.lib
LIBRARY         hal.lib                       // el reloj rapido
LIBRARY         bitgdi.lib fbscli.lib         // la pantalla: el contexto del DSA y el bitmap de la imagen
LIBRARY         mediaclientaudiostream.lib    // CMdaAudioOutputStream: la salida del mezclador
LIBRARY         remconcoreapi.lib remconinterfacebase.lib   // las teclas de volumen (RemCon)
LIBRARY         libc.lib libm.lib libstdcpp.lib
// los nucleos en asm ARM (herramientas\asm_symbian.py la deja en \epoc32\release\armv5\urel)
STATICLIBRARY   pdasm.lib
